# Template only - contains NO real values. Copy to .env and replace every placeholder.
#   cp .env.example .env
# .env is git-ignored and must never be committed.
#
# Used by docker-compose for the local SQL Server container.

# The SQL Server image requires its built-in administrator account.
SQL_ADMIN_USER=<your-sql-username>

# Must meet SQL Server complexity rules: 8+ chars with upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=<your-sql-password>

# Optional. Any GUID works; only used to print the SID the job would create.
API_IDENTITY_CLIENT_ID=
