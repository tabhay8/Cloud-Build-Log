# Template only - no real values. Copy to .env and replace the placeholders.
#   cp api/.env.example api/.env
# .env is git-ignored and must never be committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS =http://localhost:8080

SQL_SERVER=localhost
SQL_DATABASE=portfolio
SQL_PORT=1433

# Replace with your own local values.
SQL_USER=<your-sql-username>
SQL_PASSWORD=<your-sql-password>

# Local SQL in Docker presents a self-signed certificate.
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# In Azure set this to true, then leave SQL_USER and SQL_PASSWORD empty.
SQL_USE_MANAGED_IDENTITY=false

# Optional telemetry. Leave empty to disable.
APPLICATIONINSIGHTS_CONNECTION_STRING=
